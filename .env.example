# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
# PostGIS-enabled PostgreSQL 14+. `docker compose up` provides one on localhost:5432.
DATABASE_URL=postgresql://ogasabi:ogasabi@localhost:5432/ogasabi?schema=public

# ── Auth (generate with: openssl rand -base64 48) ───────────────────
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
DATA_HMAC_SECRET=change-me-change-me-change-me-change-me
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated web origins allowed by CORS. The mobile app sends no Origin header.
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=

# ── SMS / OTP: mock | termii ────────────────────────────────────────
SMS_PROVIDER=mock
TERMII_API_KEY=
TERMII_SENDER_ID=
OTP_TTL_SEC=300

# ── File storage: mock | s3 | cloudinary ─────────────────────────────
STORAGE_PROVIDER=mock
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_BYTES=8388608

# ── Payments (callout deposits). Feature-flagged off by default ──────
PAYMENTS_ENABLED=false
PAYSTACK_SECRET_KEY=

# ── Push + observability ─────────────────────────────────────────────
EXPO_ACCESS_TOKEN=
SENTRY_DSN=

# ── Scheduled jobs: secret sent as `Authorization: Bearer <secret>` ──
CRON_SECRET=change-me-change-me-change-me

# ── Locale defaults (the NEXT_PUBLIC_* ones are read by the browser) ─
DEFAULT_LOCALE=en-NG
DEFAULT_CURRENCY=NGN
DEFAULT_COUNTRY=NG
DEFAULT_CALLING_CODE=234
DEFAULT_TIMEZONE=Africa/Lagos
NEXT_PUBLIC_DEFAULT_LOCALE=en-NG
NEXT_PUBLIC_DEFAULT_CURRENCY=NGN
NEXT_PUBLIC_DEFAULT_COUNTRY=NG
NEXT_PUBLIC_DEFAULT_CALLING_CODE=234
NEXT_PUBLIC_DEFAULT_TIMEZONE=Africa/Lagos

# ── Search + requests ────────────────────────────────────────────────
SEARCH_DEFAULT_RADIUS_KM=5
SEARCH_MAX_RADIUS_KM=50
REQUEST_EXPIRY_HOURS=24

# Local only: lets the production image run with mock providers over http. Never set on a real deployment.
ALLOW_INSECURE_LOCAL=false
